# ==============================================================================
# Banking System - Environment Variables Configuration Template
# Copy this file to .env and replace placeholder values before starting.
# DO NOT commit the .env file to version control.
# ==============================================================================

# Database Credentials
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Gateway & Service URLs
PUBLIC_API_BASE_URL=http://localhost:8080

# JWT Security
# Must be a Base64-encoded HMAC-SHA256 key (minimum 256 bits / 32 bytes)
JWT_SECRET=your_base64_encoded_256bit_secret_key_here

# System Admin Initial Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@bank.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional Infrastructure Overrides (Defaults provided in compose/properties)
# REDIS_HOST=localhost
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
